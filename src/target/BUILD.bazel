"""BUILD file for TVM target/codegen infrastructure."""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

COPTS = [
    "-Wall",
    "-fPIC",
    "-std=c++17",
    "-DTVM_INDEX_DEFAULT_I64=1",
]

# Make this path available for relative includes
SRC_INCLUDES = ["-Iexternal/tvm++tvm_overlay+tvm-project/src"]

# Core target infrastructure (non-LLVM codegen)
cc_library(
    name = "target",
    srcs = glob(
        ["**/*.cc"],
        exclude = ["llvm/**"],
        allow_empty = True,
    ),
    hdrs = glob(
        ["**/*.h"],
        exclude = ["llvm/**"],
        allow_empty = True,
    ),
    copts = COPTS + SRC_INCLUDES,
    deps = [
        "//:tvm_headers",
        "//3rdparty/tvm-ffi:tvm_ffi",
        "//src/arith",
        "//src/ir",
        "//src/node",
        "//src/runtime",
        "//src/support",
        "//src/te",
        "//src/tirx",
    ],
)
