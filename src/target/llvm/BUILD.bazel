"""BUILD file for TVM LLVM codegen.

This depends on user-provided @llvm-project for LLVM libraries.
Users must provide their own hermetic LLVM in their MODULE.bazel.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Note: -fno-rtti is required for LLVM
COPTS = [
    "-Wall",
    "-fPIC",
    "-std=c++17",
    "-fno-rtti",
    "-DTVM_INDEX_DEFAULT_I64=1",
    "-DTVM_LLVM_VERSION=190",  # LLVM 19.x
    "-DNDEBUG=1",  # Required for LLVM
]

# Make this path available for relative includes
SRC_INCLUDES = ["-Iexternal/tvm++tvm_overlay+tvm-project/src"]

cc_library(
    name = "llvm",
    srcs = glob(["*.cc"]),
    hdrs = glob(["*.h"]),
    copts = COPTS + SRC_INCLUDES,
    deps = [
        "//:tvm_headers",
        "//3rdparty/tvm-ffi:tvm_ffi",
        "//src/arith",
        "//src/ir",
        "//src/node",
        "//src/runtime",
        "//src/support",
        "//src/target",
        "//src/te",
        "//src/tirx",
        # LLVM dependencies - user provides @llvm-project
        "@llvm-project//llvm:Analysis",
        "@llvm-project//llvm:BinaryFormat",
        "@llvm-project//llvm:BitReader",
        "@llvm-project//llvm:BitWriter",
        "@llvm-project//llvm:CodeGen",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:ExecutionEngine",
        "@llvm-project//llvm:IRPrinter",
        "@llvm-project//llvm:IRReader",
        "@llvm-project//llvm:MC",
        "@llvm-project//llvm:MCJIT",
        "@llvm-project//llvm:OrcJIT",
        "@llvm-project//llvm:OrcTargetProcess",
        "@llvm-project//llvm:Passes",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:Target",
        "@llvm-project//llvm:TransformUtils",
    ] + select({
        # Platform-specific codegen backends
        "@platforms//cpu:x86_64": [
            "@llvm-project//llvm:X86AsmParser",
            "@llvm-project//llvm:X86CodeGen",
        ],
        "@platforms//cpu:aarch64": [
            "@llvm-project//llvm:AArch64AsmParser",
            "@llvm-project//llvm:AArch64CodeGen",
        ],
        "//conditions:default": [],
    }),
)
