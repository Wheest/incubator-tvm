# TVM Bazel configuration

# C++17 required
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# Enable position-independent code
build --copt=-fPIC

# Use compatible LLVM flags
build --copt=-DNDEBUG

# Optimisation level
build --copt=-O2
build --host_copt=-O2

# Platform-specific settings
build:macos --copt=-faligned-new
build:linux --copt=-faligned-new

# Disable RTTI for LLVM compatibility (applied globally, LLVM sources need it)
# Individual targets can override with -frtti if needed
# build --copt=-fno-rtti

# Threading
build --copt=-pthread
build --linkopt=-pthread

# Debug builds
build:debug --compilation_mode=dbg
build:debug --copt=-O0
build:debug --copt=-g

# Release builds
build:release --compilation_mode=opt
build:release --copt=-O3

# Address sanitizer
build:asan --strip=never
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address
