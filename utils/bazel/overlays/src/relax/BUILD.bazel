"""BUILD file for TVM Relax (next-gen relay)."""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

COPTS = [
    "-Wall",
    "-fPIC",
    "-std=c++17",
    "-DTVM_INDEX_DEFAULT_I64=1",
    "-faligned-allocation",  # Required for aligned new/delete
    "-mmacosx-version-min=10.15",  # Required for std::filesystem
]

# Make these paths available for relative includes
# - src/ for includes like "../../arith/file.h"
# - src/relax/transform/ for includes like "../../s_tir/..." (resolves via -I search)
SRC_INCLUDES = [
    "-Iexternal/tvm++tvm_overlay+tvm-project/src",
    "-Iexternal/tvm++tvm_overlay+tvm-project/src/relax/transform",
]

cc_library(
    name = "relax",
    srcs = glob(["**/*.cc"], allow_empty = True),
    hdrs = glob(["**/*.h"], allow_empty = True),
    copts = COPTS + SRC_INCLUDES,
    deps = [
        "//:tvm_headers",
        "//3rdparty/tvm-ffi:tvm_ffi",
        "//src/arith",
        "//src/ir",
        "//src/node",
        "//src/runtime",
        "//src/s_tir",
        "//src/support",
        "//src/te",
        "//src/tirx",
    ],
)
