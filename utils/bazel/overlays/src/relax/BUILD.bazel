"""BUILD file for TVM Relax (next-gen relay)."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//:tvm_rules.bzl", "TVM_COPTS")

package(default_visibility = ["//visibility:public"])

# macOS requires deployment target for std::filesystem
MACOS_COPTS = select({
    "@platforms//os:macos": ["-mmacosx-version-min=10.15"],
    "//conditions:default": [],
})

cc_library(
    name = "relax",
    srcs = glob([
        "*.cc",
        "analysis/**/*.cc",
        "backend/*.cc",
        "backend/adreno/**/*.cc",
        "backend/vm/**/*.cc",
        "distributed/**/*.cc",
        "ir/**/*.cc",
        "op/**/*.cc",
        "testing/**/*.cc",
        "training/**/*.cc",
        "transform/**/*.cc",
    ], allow_empty = True),
    hdrs = glob([
        "*.h",
        "analysis/**/*.h",
        "backend/*.h",
        "backend/adreno/**/*.h",
        "backend/vm/**/*.h",
        "backend/contrib/codegen_c/**/*.h",
        "backend/contrib/codegen_json/**/*.h",
        "distributed/**/*.h",
        "ir/**/*.h",
        "op/**/*.h",
        "testing/**/*.h",
        "training/**/*.h",
        "transform/**/*.h",
    ], allow_empty = True),
    copts = TVM_COPTS + MACOS_COPTS,
    includes = ["transform"],  # For relative includes from transform/
    deps = [
        "//:tvm_headers",
        "//:tvm_internal_hdrs",
        "//3rdparty/tvm-ffi:tvm_ffi",
        "//src/arith",
        "//src/ir",
        "//src/node",
        "//src/runtime",
        "//src/s_tir",
        "//src/support",
        "//src/te",
        "//src/tirx",
    ],
)
