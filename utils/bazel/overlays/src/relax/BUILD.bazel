"""BUILD file for TVM Relax (next-gen relay)."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//:tvm_rules.bzl", "TVM_COPTS", "TVM_SRC_INCLUDES")

package(default_visibility = ["//visibility:public"])

# Additional include for relax/transform subdir
RELAX_INCLUDES = TVM_SRC_INCLUDES + ["-Iexternal/tvm++tvm_overlay+tvm-project/src/relax/transform"]

# macOS requires deployment target for std::filesystem
MACOS_COPTS = select({
    "@platforms//os:macos": ["-mmacosx-version-min=10.15"],
    "//conditions:default": [],
})

cc_library(
    name = "relax",
    # Explicit includes because glob exclude doesn't work reliably with symlinked dirs
    srcs = glob([
        "*.cc",
        "analysis/**/*.cc",
        "backend/*.cc",  # pattern_registry.cc, task_extraction.cc
        "backend/adreno/**/*.cc",
        "backend/vm/**/*.cc",
        # backend/contrib/**/*.cc excluded - requires CUDA/cuDNN/etc.
        "distributed/**/*.cc",
        "ir/**/*.cc",
        "op/**/*.cc",
        "testing/**/*.cc",
        "training/**/*.cc",
        "transform/**/*.cc",
    ], allow_empty = True),
    hdrs = glob([
        "*.h",
        "analysis/**/*.h",
        "backend/*.h",
        "backend/adreno/**/*.h",
        "backend/vm/**/*.h",
        "backend/contrib/codegen_c/**/*.h",  # Base codegen headers needed by other code
        "backend/contrib/codegen_json/**/*.h",
        # backend/contrib/<vendor>/**/*.h excluded - vendor-specific
        "distributed/**/*.h",
        "ir/**/*.h",
        "op/**/*.h",
        "testing/**/*.h",
        "training/**/*.h",
        "transform/**/*.h",
    ], allow_empty = True),
    copts = TVM_COPTS + RELAX_INCLUDES + MACOS_COPTS,
    deps = [
        "//:tvm_headers",
        "//3rdparty/tvm-ffi:tvm_ffi",
        "//src/arith",
        "//src/ir",
        "//src/node",
        "//src/runtime",
        "//src/s_tir",
        "//src/support",
        "//src/te",
        "//src/tirx",
    ],
)
