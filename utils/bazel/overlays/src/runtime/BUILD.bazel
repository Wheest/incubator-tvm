"""BUILD file for TVM runtime."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//:tvm_rules.bzl", "TVM_COPTS")

package(default_visibility = ["//visibility:public"])

# Disco distributed sources - included on Linux/macOS
DISCO_DISTRIBUTED_SRCS = glob(["disco/distributed/*.cc"])

cc_library(
    name = "runtime",
    srcs = glob(
        [
            "*.cc",
            "vm/*.cc",
            "memory/*.cc",
            "disco/*.cc",
            "rpc/*.cc",
        ],
        exclude = [
            "**/*_test.cc",
            "disco/distributed/*.cc",
        ],
        allow_empty = True,
    ) + select({
        "@platforms//os:linux": DISCO_DISTRIBUTED_SRCS,
        "@platforms//os:macos": DISCO_DISTRIBUTED_SRCS,
        "//conditions:default": [],
    }),
    hdrs = glob([
        "*.h",
        "**/*.h",
    ], allow_empty = True),
    copts = TVM_COPTS,
    alwayslink = True,
    linkopts = select({
        "@platforms//os:linux": ["-lpthread", "-ldl"],
        "@platforms//os:macos": ["-lpthread"],
        "//conditions:default": [],
    }),
    deps = [
        "//:tvm_headers",
        "//:tvm_internal_hdrs",
        "//:compiler_rt_headers",
        "//3rdparty/tvm-ffi:tvm_ffi",
        "//3rdparty/tvm-ffi:tvm_ffi_extra",
        "//src/support:support_runtime",
    ],
)
