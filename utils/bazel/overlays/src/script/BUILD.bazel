"""BUILD file for TVM script parser."""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

COPTS = [
    "-Wall",
    "-fPIC",
    "-std=c++17",
    "-DTVM_INDEX_DEFAULT_I64=1",
    "-faligned-allocation",
]

# Make this path available for relative includes
SRC_INCLUDES = ["-Iexternal/tvm++tvm_overlay+tvm-project/src"]

cc_library(
    name = "script",
    srcs = glob(["**/*.cc"], allow_empty = True),
    hdrs = glob(["**/*.h"], allow_empty = True),
    copts = COPTS + SRC_INCLUDES,
    deps = [
        "//:tvm_headers",
        "//3rdparty/tvm-ffi:tvm_ffi",
        "//src/ir",
        "//src/node",
        "//src/runtime",
        "//src/support",
        "//src/tirx",
    ],
)
