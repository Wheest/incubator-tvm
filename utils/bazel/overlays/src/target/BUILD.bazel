"""BUILD file for TVM target/codegen infrastructure."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//:tvm_rules.bzl", "TVM_COPTS")

package(default_visibility = ["//visibility:public"])

# Filegroup for LLVM canonicalizer files (accessible from //src/target/llvm)
filegroup(
    name = "canonicalizer_llvm_srcs",
    srcs = glob(["canonicalizer/llvm/*.cc"]),
)

filegroup(
    name = "canonicalizer_llvm_hdrs",
    srcs = glob(["canonicalizer/llvm/*.h"]),
)

# Headers-only target for cross-module includes
cc_library(
    name = "target_hdrs",
    hdrs = glob(
        ["**/*.h"],
        exclude = [
            "llvm/**",
            "spirv/**",
        ],
        allow_empty = True,
    ),
    copts = TVM_COPTS,
    deps = [
        "//:tvm_headers",
        "//:tvm_internal_hdrs",
        "//3rdparty/tvm-ffi:tvm_ffi",
        "//src/runtime",
    ],
)

# Core target infrastructure (non-LLVM codegen)
cc_library(
    name = "target",
    srcs = glob(
        ["**/*.cc"],
        exclude = [
            "llvm/**",
            "canonicalizer/llvm/**",
            "spirv/**",
            "source/codegen_opencl.cc",
            "opt/*_on.cc",
            "datatype/posit/**",
        ],
        allow_empty = True,
    ),
    copts = TVM_COPTS,
    alwayslink = True,
    deps = [
        ":target_hdrs",
        "//:tvm_internal_hdrs",
        "//src/arith",
        "//src/ir",
        "//src/node",
        "//src/runtime",
        "//src/support",
        "//src/te",
        "//src/tirx",
    ],
)
