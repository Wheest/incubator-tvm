"""BUILD file for TVM TIR extensions."""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

COPTS = [
    "-Wall",
    "-fPIC",
    "-std=c++17",
    "-DTVM_INDEX_DEFAULT_I64=1",
    "-faligned-allocation",
]

# Include paths for TVM's relative includes:
# - src/ for includes like "arith/file.h" and "../../src/arith/file.h"
# - src/tirx/ for includes like "../../arith/file.h" from analysis/
SRC_INCLUDES = [
    "-Iexternal/tvm++tvm_overlay+tvm-project/src",
    "-Iexternal/tvm++tvm_overlay+tvm-project/src/tirx",
]

cc_library(
    name = "tirx",
    srcs = glob(["**/*.cc"], allow_empty = True),
    hdrs = glob(["**/*.h"], allow_empty = True),
    copts = COPTS + SRC_INCLUDES,
    deps = [
        "//:tvm_headers",
        "//:tvm_internal_hdrs",  # For cross-module relative includes
        "//3rdparty/tvm-ffi:tvm_ffi",
        "//src/arith:arith_hdrs",  # Headers only to break cycle (arith links to tirx)
        "//src/ir",
        "//src/node",
        "//src/runtime",
        "//src/support",
    ],
)
